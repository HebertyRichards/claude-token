#!/usr/bin/env python3
"""claude-token — economiza e mede tokens do Claude Code.

Comandos:
  on | off | status    liga/desliga o otimizador
  report [--days N]    tokens/custo: ligado vs desligado
  cache [--days N]     eficiência do prompt cache e turnos frios
  index [caminho]      indexa o projeto para o RAG
  search <consulta>    busca BM25 no projeto indexado
  recall <consulta>    busca em sessões passadas (resumos + transcripts)
  toon [arquivo]       compacta JSON/logs antes de colar no prompt
  tips                 aponta desperdícios de configuração
  hook | statusline | digest    interno, chamado pelo Claude Code
"""
import os
import sys

# Resolve the real location (works when invoked via the ~/.local/bin symlink).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hook import cmd_hook
from lean import cmd_posttool
from rag import cmd_index, cmd_search
from recall import cmd_digest, cmd_recall
from report import cmd_cache, cmd_report, cmd_tips
from statusline import cmd_statusline
from toggle import cmd_off, cmd_on, cmd_status
from toon import cmd_toon


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    fn = {
        "on": cmd_on, "off": cmd_off, "status": cmd_status,
        "hook": cmd_hook, "statusline": cmd_statusline, "tips": cmd_tips,
        "digest": cmd_digest, "posttool": cmd_posttool,
        "report": lambda: cmd_report(sys.argv[2:]),
        "cache": lambda: cmd_cache(sys.argv[2:]),
        "index": lambda: cmd_index(sys.argv[2:]),
        "search": lambda: cmd_search(sys.argv[2:]),
        "recall": lambda: cmd_recall(sys.argv[2:]),
        "toon": lambda: cmd_toon(sys.argv[2:]),
    }.get(cmd)
    if fn:
        fn()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
