#!/usr/bin/env python3
"""claude-token — economiza e mede tokens do Claude Code.

Comandos:
  on | off | status    liga/desliga o otimizador
  level [0-2]          quanto o harness injeta (sem arg: mostra os níveis)
  memory [id]          o que foi feito numa sessão (padrão: a atual)
  sessions [--days N]  lista sessões passadas por id
  report [--days N]    tokens e custo do período
  cache [--days N]     eficiência do prompt cache e turnos frios
  index [caminho]      indexa o projeto para o RAG
  search <consulta>    busca BM25 no projeto indexado
  recall <consulta>    acha em quais sessões passadas um assunto aparece
  toon [arquivo]       compacta JSON/XML/HTML/logs/docx antes de colar no prompt
  tips                 aponta desperdícios de configuração
  hook | statusline | posttool     interno, chamado pelo Claude Code
"""
import os
import sys

# Resolve the real location (works when invoked via the ~/.local/bin symlink).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

# Windows pipes default to cp1252, which can't encode the statusline emoji and
# mangles accented prompts; Claude Code speaks UTF-8 on both ends. Text mode
# there also writes "\r\n": pin "\n" so the statusline and the notes the hook
# hands the model are byte-for-byte what Linux emits.
if hasattr(sys.stdin, "reconfigure"):
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):
        _s.reconfigure(encoding="utf-8", errors="replace", newline="\n")

from hook import cmd_hook
from lean import cmd_posttool
from memory import cmd_memory
from rag import cmd_index, cmd_search
from recall import cmd_recall, cmd_sessions
from report import cmd_cache, cmd_report, cmd_tips
from statusline import cmd_statusline
from toggle import cmd_level, cmd_off, cmd_on, cmd_status
from toon import cmd_toon


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    fn = {
        "on": cmd_on, "off": cmd_off, "status": cmd_status,
        "hook": cmd_hook, "statusline": cmd_statusline, "tips": cmd_tips,
        "posttool": cmd_posttool,
        "memory": lambda: cmd_memory(sys.argv[2:]),
        "level": lambda: cmd_level(sys.argv[2:]),
        "report": lambda: cmd_report(sys.argv[2:]),
        "cache": lambda: cmd_cache(sys.argv[2:]),
        "index": lambda: cmd_index(sys.argv[2:]),
        "search": lambda: cmd_search(sys.argv[2:]),
        "recall": lambda: cmd_recall(sys.argv[2:]),
        "sessions": lambda: cmd_sessions(sys.argv[2:]),
        "toon": lambda: cmd_toon(sys.argv[2:]),
    }.get(cmd)
    if fn:
        fn()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
