#!/usr/bin/env python3
"""claude-token — token saver and meter for Claude Code.

Commands:
  on | off | status    toggle the optimizer
  report [--days N]    tokens/cost: ON vs OFF periods
  tips                 spot token-wasting config
  hook | statusline    internal, called by Claude Code
"""
import os
import sys

# Resolve the real location (works when invoked via the ~/.local/bin symlink).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hook import cmd_hook
from report import cmd_report, cmd_tips
from statusline import cmd_statusline
from toggle import cmd_off, cmd_on, cmd_status


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    fn = {
        "on": cmd_on, "off": cmd_off, "status": cmd_status,
        "hook": cmd_hook, "statusline": cmd_statusline, "tips": cmd_tips,
        "report": lambda: cmd_report(sys.argv[2:]),
    }.get(cmd)
    if fn:
        fn()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
